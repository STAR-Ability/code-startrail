# Local Node.js development. Compose sets its own container paths and Judge URL.
DATABASE_PATH=./storage/codestartrail.sqlite
JUDGE_URL=http://127.0.0.1:5050
# Behind HTTPS reverse proxy: COOKIE_SECURE=true and APP_ORIGIN=https://your-domain
COOKIE_SECURE=false
# APP_ORIGIN=https://your-domain

# Docker Compose: copy this file to .env, then configure the server listener.
# Use 0.0.0.0 for direct access from the server's IP; keep 127.0.0.1 behind a local proxy.
BIND_ADDRESS=127.0.0.1
PORT=3000

# Optional build sources when Docker Hub or the default Debian mirror is unreachable.
# NODE_IMAGE=public.ecr.aws/docker/library/node:24-alpine
# DEBIAN_IMAGE=public.ecr.aws/docker/library/debian:bookworm-slim
# DEBIAN_MIRROR=mirrors.ustc.edu.cn

# Only needed with docker-compose.prod.yml (prebuilt images instead of source builds).
# ACM_AGENT_IMAGE=ghcr.io/star-ability/acm-training-agent:sha-<commit>
# JUDGE_IMAGE=ghcr.io/star-ability/acm-training-agent-judge:sha-<commit>
