      "input": "3\n0 10\n1 2\n2 3\n",
      "output": "1\n"
    },
    {
      "input": "3\n1 5\n2 4\n3 6\n",
      "output": "1\n"
    },
    {
      "input": "3\n0 1\n1 2\n2 3\n",
      "output": "1\n"
    },
    {
      "input": "3\n5 8\n0 2\n2 5\n",
      "output": "1\n"
    },
    {
      "input": "5\n0 100\n1 3\n4 6\n7 9\n10 12\n",
      "output": "1\n"
    }
