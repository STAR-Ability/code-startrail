{
  "id": "p11",
  "slug": "range-sum",
  "title": "区间求和",
  "difficulty": 2,
  "tags": [
    "数组",
    "前缀和"
  ],
  "description": "多次询问数组区间 [l,r] 的元素和，下标从 1 开始。",
  "inputDescription": "n,q（1≤n,q≤10^5）；n 个绝对值≤10^9 的整数；随后 q 行 l,r（1≤l≤r≤n）。",
  "outputDescription": "每行输出一个区间和。",
  "samples": [
    {
      "input": "5 2\n1 2 3 4 5\n1 3\n2 5\n",
      "output": "6\n14\n"
    },
    {
      "input": "3 1\n-1 0 2\n1 3\n",
      "output": "1\n"
    }
  ],
  "hiddenTests": [
    {
      "input": "1 1\n0\n1 1\n",
      "output": "0\n"
    },
    {
      "input": "2 2\n1000000000 1000000000\n1 2\n2 2\n",
      "output": "2000000000\n1000000000\n"
    },
    {
      "input": "4 2\n-3 -2 -1 -4\n1 4\n2 3\n",
      "output": "-10\n-3\n"
    },
    {
      "input": "3 3\n2 2 2\n1 1\n2 2\n3 3\n",
      "output": "2\n2\n2\n"
    },
    {
      "input": "5 2\n0 0 0 0 0\n1 5\n3 4\n",
      "output": "0\n0\n"
    },
    {
      "input": "6 3\n1 -1 1 -1 1 -1\n1 6\n2 5\n3 3\n",
      "output": "0\n0\n1\n"
    }
  ],
  "timeLimitMs": 1000,
  "memoryLimitMb": 128,
  "estimatedMinutes": 20,
  "objective": "相邻两次查询可能重复计算哪些值？",
  "source": "码练星轨 · 原创 Demo 题",
  "version": 1,
  "hints": [
    "相邻两次查询可能重复计算哪些值？",
    "预先保存从开头到每个位置的和。",
    "区间 [l,r] 的和可由两个前缀和相减。"
  ],
  "solutionOutline": "定义 s[0]=0，s[i]=s[i-1]+a[i]。查询为 s[r]-s[l-1]。总时间 O(n+q)，用 long long。"
}
