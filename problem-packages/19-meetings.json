  ],
  "description": "选择尽可能多的活动，时间段 [l,r) 不重叠。前一个活动结束时可立即开始下一个。",
  "inputDescription": "n（1≤n≤10^5）；随后 n 行 l,r（0≤l<r≤10^9）。",
  "outputDescription": "最多活动数量。",
  "samples": [
    {
      "input": "3\n1 3\n2 4\n3 5\n",
      "output": "2\n"
    },
    {
      "input": "1\n0 1\n",
      "output": "1\n"
    }
  ],
  "hiddenTests": [
    {
      "input": "2\n1 2\n1 2\n",
      "output": "1\n"
    },
    {
      "input": "3\n0 10\n1 2\n2 3\n",
      "output": "2\n"
    },
    {
      "input": "3\n1 5\n2 4\n3 6\n",
      "output": "1\n"
    },
    {
      "input": "3\n0 1\n1 2\n2 3\n",
      "output": "3\n"
    },
    {
      "input": "3\n5 8\n0 2\n2 5\n",
      "output": "3\n"
    },
    {
      "input": "5\n0 100\n1 3\n4 6\n7 9\n10 12\n",
      "output": "4\n"
    }
