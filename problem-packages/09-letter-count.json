  "description": "统计字符串中指定小写字母的出现次数。",
  "inputDescription": "第一行非空小写字符串 s（长度≤10^5），第二行一个小写字母 c。",
  "outputDescription": "输出 c 的出现次数。",
  "samples": [
    {
      "input": "banana\na\n",
      "output": "3\n"
    },
    {
      "input": "hello\nl\n",
      "output": "2\n"
    }
  ],
  "hiddenTests": [
    {
      "input": "a\na\n",
      "output": "1\n"
    },
    {
      "input": "abc\nz\n",
      "output": "0\n"
    },
    {
      "input": "aaaaaa\na\n",
      "output": "6\n"
    },
    {
      "input": "zzzz\nz\n",
      "output": "4\n"
    },
    {
      "input": "abcdef\na\n",
      "output": "1\n"
    },
    {
      "input": "\nb\n",
      "output": "0\n"
    }
  ],
  "timeLimitMs": 1000,
  "memoryLimitMb": 128,
  "estimatedMinutes": 20,
  "objective": "如何逐个访问字符串中的字符？",
  "source": "码练星轨 · 原创 Demo 题",
  "version": 1,
  "hints": [
    "如何逐个访问字符串中的字符？",
    "只在当前字符等于目标时增加计数。",
    "从 0 开始，扫描全部字符并比较。"
  ],
  "solutionOutline": "一次遍历，遇到目标字母则计数加一。O(|s|) 时间，O(1) 额外空间。"
