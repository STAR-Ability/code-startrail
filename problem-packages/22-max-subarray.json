{
  "id": "p22",
  "slug": "max-subarray",
  "title": "最大连续和",
  "difficulty": 4,
  "tags": [
    "动态规划",
    "数组"
  ],
  "description": "选择一段非空连续子数组，使其元素和最大。",
  "inputDescription": "n（1≤n≤10^5），随后 n 个整数，绝对值≤10^9。",
  "outputDescription": "最大连续和。",
  "samples": [
    {
      "input": "9\n-2 1 -3 4 -1 2 1 -5 4\n",
      "output": "6\n"
    },
    {
      "input": "2\n1 2\n",
      "output": "3\n"
    }
  ],
  "hiddenTests": [
    {
      "input": "1\n0\n",
      "output": "0\n"
    },
    {
      "input": "3\n-9 -2 -7\n",
      "output": "-2\n"
    },
    {
      "input": "2\n1000000000 1000000000\n",
      "output": "2000000000\n"
    },
    {
      "input": "3\n5 -10 6\n",
      "output": "6\n"
    },
    {
      "input": "4\n1 -1 1 -1\n",
      "output": "1\n"
    },
    {
      "input": "1\n-1\n",
      "output": "-1\n"
    }
  ],
  "timeLimitMs": 1000,
  "memoryLimitMb": 128,
  "estimatedMinutes": 30,
  "objective": "以当前位置结尾的最优段，能从上一位置的哪种状态转移？",
  "source": "码练星轨 · 原创 Demo 题",
  "version": 1,
  "hints": [
    "以当前位置结尾的最优段，能从上一位置的哪种状态转移？",
    "之前的连续和为负时，还值得保留吗？",
    "维护以当前元素结尾的最大和，以及全局最大和。"
  ],
  "solutionOutline": "cur=max(a[i],cur+a[i])，best=max(best,cur)。非空条件意味着不能把答案初始为 0；全负数组应返回最大元素。O(n)，long long。"
}
